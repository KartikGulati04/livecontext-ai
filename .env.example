# LiveContext AI Configuration

# Core Application
APP_NAME=LiveContext AI
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-in-production-to-a-cryptographically-secure-random-key

# Database
# Use local SQLite database or PostgreSQL with pgvector:
DATABASE_URL=sqlite+aiosqlite:///./livecontext.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/livecontext
ENABLE_PGVECTOR=false

# LLM Providers (Optional - high-fidelity deterministic engine activates automatically when unconfigured)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Embeddings & RAG
EMBEDDING_PROVIDER=auto
EMBEDDING_DIMENSION=768
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.35

# Agent Limits
AGENT_MAX_ITERATIONS=3
AGENT_MAX_TOOL_CALLS=8
AGENT_EXECUTION_TIMEOUT_SECONDS=60
